# ─────────────────────────────────────────────────────────────────────
# AgentTrader CL — Variables de Entorno
# Copia este archivo como .env y completa los valores reales.
# NUNCA subas .env a git.
# ─────────────────────────────────────────────────────────────────────

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agenttrader
DB_USER=trader
DB_PASSWORD=CAMBIAR_PASSWORD_SEGURO

# Gmail SMTP (usa App Password de Google, no tu contraseña real)
# Guía: https://support.google.com/accounts/answer/185833
GMAIL_USER=tu_cuenta@gmail.com
GMAIL_APP_PASS=xxxx xxxx xxxx xxxx

# Email destino de alertas
ALERT_EMAIL=rekkiem@gmail.com

# Valor total del portafolio en CLP (actualizar periódicamente)
PORTFOLIO_VALUE_CLP=10000000

# ─────────────────────────────────────────────────────────────────────
# Alpha Vantage — Fuente de datos alternativa (GRATIS, 25 req/día)
# Si yfinance y Stooq fallan, esta es la última opción.
# Obtener clave gratuita en: https://www.alphavantage.co/support/#api-key
# ─────────────────────────────────────────────────────────────────────
ALPHA_VANTAGE_KEY=

# Sentry para monitoreo de errores (opcional)
SENTRY_DSN=
